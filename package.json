{
  "name": "@openscout/search",
  "version": "0.1.0",
  "description": "Find the session where your coding agents discussed a change, ran a command, or made a decision.",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/openscout-app/search.git" },
  "type": "module",
  "exports": {
    "./passages": { "types": "./ui/passages.d.ts", "import": "./ui/passages.jsx" },
    "./passages.css": "./ui/passages.css",
    "./package.json": "./package.json"
  },
  "bin": { "scout-search": "bin/scout-search.mjs" },
