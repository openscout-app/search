{
  "name": "@openscout/search",
  "version": "0.2.0",
  "description": "Find the session where your coding agents discussed a change, ran a command, or made a decision. Prebuilt HTML served on loopback and backed by the Scout CLI.",
  "license": "Apache-2.0",
  "homepage": "https://openscout.app/search",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openscout-app/search.git"
  },
  "type": "module",
  "exports": {
    "./passages": {
      "types": "./ui/passages.d.ts",
      "import": "./ui/passages.jsx"
    },
    "./passages.css": "./ui/passages.css",
    "./package.json": "./package.json",
    "./surface": {
      "types": "./ui/surface.d.ts",
      "import": "./ui/surface.jsx"
    },
    "./coverage": {
      "types": "./ui/coverage.d.ts",
      "import": "./ui/coverage.js"
    },
    "./windows": {
      "types": "./shared/windows.d.ts",
      "import": "./shared/windows.mjs"
    }
  },
  "bin": {
    "scout-search": "bin/scout-search.mjs"
  },
  "files": [
    "bin",
    "server/*.mjs",
    "shared",
    "dist",
    "ui",
    "docs/search.png",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node bin/scout-search.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@openscout/scout": "^0.5.4"
  },
  "devDependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "scout-app": "github:openscout-app/scout-app#feba9e6",
    "vite": "^7.0.0"
  }
}
